  "stages": [
    {
      "name": "A-forage", "description": "smoke test: forage alone", "timesteps": 20000,
      "scenarios": [{ "name": "forage", "opponents": [], "maxSeconds": 30, "config": { "thornCount": 0 } }]
    },
    {
      "name": "E-selfplay", "description": "smoke test: self-play wiring", "timesteps": 8000, "selfplay_refresh": 4000,
      "scenarios": [{
        "name": "selfplay", "maxSeconds": 30, "config": { "respawn": true },
        "opponents": [{ "kind": "ppo", "count": 2, "modelId": "selfplay-snapshot" }, { "kind": "greedy", "count": 2 }]
      }]
    }
  ]
}
