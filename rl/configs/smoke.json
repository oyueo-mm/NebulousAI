{
  "id": "smoke",
  "seed": 1000000,
  "num_envs": 8,
  "processes": 2,
  "torch_threads": 2,
  "decision_interval": 2,
  "reward": {},
  "normalize": { "obs": true, "reward": true, "clip_obs": 10.0 },
  "ppo": {
    "n_steps": 128, "batch_size": 256, "n_epochs": 3, "learning_rate": 0.0003, "gamma": 0.99, "gae_lambda": 0.95,
    "clip_range": 0.2, "ent_coef": 0.01, "vf_coef": 0.5, "max_grad_norm": 0.5, "net_arch": [64, 64], "activation": "tanh"
